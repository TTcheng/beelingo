{
  "name": "beelingo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "选中即译 — 浏览器划词翻译扩展",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch --config vite.config.chrome.ts",
    "dev:chrome": "vite build --watch --config vite.config.chrome.ts",
    "dev:firefox": "vite build --watch --config vite.config.firefox.ts",
    "build": "vite build --config vite.config.chrome.ts",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "build:all": "pnpm build:chrome && pnpm build:firefox",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}